{
  "ci": {
    "collect": {
      "startServerCommand": "npx --yes serve dist -l 4173",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/services.html",
        "http://localhost:4173/products.html",
        "http://localhost:4173/contact.html"
      ],
      "numberOfRuns": 2
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
